<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DraftEngine.App\DraftEngine.App.csproj" />
  </ItemGroup>

  <!-- The compiled App.xaml is not readable from the test assembly, so copy the source
       markup next to the tests for the template/key assertions. -->
  <ItemGroup>
    <None Include="..\DraftEngine.App\App.xaml" Link="App.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DraftEngine.App\MainWindow.xaml" Link="Xaml\MainWindow.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DraftEngine.App\Views\*.xaml" Link="Xaml\Views\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DraftEngine.App\Resources\Strings*.resx" Link="Resources\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DraftEngine.App\Themes\Light.xaml" Link="Themes\Light.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DraftEngine.App\Themes\Dark.xaml" Link="Themes\Dark.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DraftEngine.App\Themes\Styles.xaml" Link="Themes\Styles.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DraftEngine.App\Themes\HighContrast.xaml" Link="Themes\HighContrast.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\docs\i18n-baseline.txt" Link="i18n-baseline.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
