<Window x:Class="DraftEngine.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:DraftEngine.App"
        xmlns:loc="clr-namespace:DraftEngine.App.Services.Localization"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Style="{StaticResource LocalizedWindowStyle}"
        Height="820" Width="1280"
        MinHeight="700" MinWidth="1100"
        WindowState="Maximized"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- One sidebar entry: leading accent bar, icon and label. FlowDirection mirrors it for RTL. -->
        <DataTemplate x:Key="NavItemTemplate">
            <Button Style="{StaticResource NavItemButtonStyle}"
                    Command="{Binding Command}"
                    AutomationProperties.Name="{Binding AutomationName}"
                    ToolTip="{Binding Label}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Icon}" Style="{StaticResource NavIconStyle}" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding Label}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NavigateNewContractCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding NavigateContractsCommand}" />
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding NavigateAnalyzeCommand}" />
    </Window.InputBindings>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource PrimaryBrush}"
                Padding="16,10"
                Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding UpdateBannerText}"
                               Foreground="{DynamicResource ForegroundBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding UpdateErrorMessage}"
                               Foreground="{DynamicResource ForegroundBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{Binding UpdateButtonText}"
                        Command="{Binding DownloadAndInstallUpdateCommand}"
                        IsEnabled="{Binding CanDownloadUpdate}"
                        Margin="12,0"
                        Padding="14,6"
                        AutomationProperties.Name="{loc:T Update.Now}" />
                <Button Grid.Column="2"
                        Content="{loc:T Update.Dismiss}"
                        Command="{Binding DismissUpdateCommand}"
                        Padding="10,6"
                        AutomationProperties.Name="{loc:T Update.DismissAutomation}" />
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left sidebar (mirrors to the right in RTL via FlowDirection) -->
            <Border Grid.Column="0"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Source={x:Static loc:LocalizationSource.Current}, Path=IsRtl}"
                                         Value="True">
                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel LastChildFill="True">

                    <!-- Brand with deep blue accent bar -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource AccentBrush}" Padding="16,18">
                        <TextBlock Text="DraftEngine"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                    </Border>

                    <!-- Bottom group: Settings pinned, optional About, then version + commit -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="8,4,8,12">
                        <Separator Margin="8,0,8,6"
                                   Background="{DynamicResource BorderSubtleBrush}"
                                   BorderBrush="{DynamicResource BorderSubtleBrush}" />
                        <ItemsControl ItemsSource="{Binding BottomItems}"
                                      ItemTemplate="{StaticResource NavItemTemplate}" />
                        <StackPanel Margin="16,10,16,0">
                            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                       Text="{Binding VersionDisplay}"
                                       AutomationProperties.Name="{loc:T Main.VersionAutomation}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                       Text="{Binding CommitDisplay}"
                                       Visibility="{Binding HasCommit, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Scrollable nav: Workspace and Tools groups -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  KeyboardNavigation.TabNavigation="Continue">
                        <StackPanel Margin="8,8,8,0">
                            <TextBlock Text="{loc:T Nav.GroupWorkspace}"
                                       Style="{StaticResource NavGroupHeaderStyle}" />
                            <ItemsControl ItemsSource="{Binding WorkspaceItems}"
                                          ItemTemplate="{StaticResource NavItemTemplate}" />

                            <TextBlock Text="{loc:T Nav.GroupTools}"
                                       Style="{StaticResource NavGroupHeaderStyle}" />
                            <ItemsControl ItemsSource="{Binding ToolsItems}"
                                          ItemTemplate="{StaticResource NavItemTemplate}" />
                        </StackPanel>
                    </ScrollViewer>

                </DockPanel>
            </Border>

            <!-- Right content area -->
            <ContentControl Grid.Column="1"
                            Margin="24"
                            Content="{Binding CurrentViewModel}" />
        </Grid>
    </DockPanel>
</Window>
