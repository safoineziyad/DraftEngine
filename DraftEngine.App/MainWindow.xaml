<Window x:Class="DraftEngine.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:app="clr-namespace:DraftEngine.App"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="820" Width="1280"
        MinHeight="700" MinWidth="1100"
        WindowState="Maximized"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NavigateNewContractCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding NavigateContractsCommand}" />
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding NavigateAnalyzeCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">

                <!-- App title with deep blue accent bar -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource AccentBrush}" Padding="16,18">
                    <TextBlock Text="DraftEngine"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="SemiBold" />
                </Border>

                <!-- Navigation menu -->
                <StackPanel DockPanel.Dock="Top" Margin="8,12">
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="Dashboard"
                            AutomationProperties.Name="Go to Dashboard"
                            Command="{Binding NavigateDashboardCommand}" />
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="New Contract"
                            AutomationProperties.Name="Start a new contract"
                            Command="{Binding NavigateNewContractCommand}" />
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="Contracts"
                            AutomationProperties.Name="Go to Contracts list"
                            Command="{Binding NavigateContractsCommand}" />
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="Settings"
                            AutomationProperties.Name="Go to Settings"
                            Command="{Binding NavigateSettingsCommand}" />
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="Analyze"
                            AutomationProperties.Name="Analyze a contract"
                            Command="{Binding NavigateAnalyzeCommand}" />
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="Clause Manager"
                            AutomationProperties.Name="Go to Clause Manager"
                            Command="{Binding NavigateClauseManagementCommand}" />
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="Archived Contracts"
                            AutomationProperties.Name="Go to Archived Contracts"
                            Command="{Binding NavigateArchivedContractsCommand}" />
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="About &amp; Help"
                            AutomationProperties.Name="Go to About and Help"
                            Command="{Binding NavigateAboutCommand}"
                            Visibility="{Binding AboutEnabled, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Bottom: version + settings shortcut -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,16">
                    <Separator Margin="0,0,0,8"
                               Background="{DynamicResource BorderSubtleBrush}"
                               BorderBrush="{DynamicResource BorderSubtleBrush}" />
                    <!-- Version comes from the csproj <Version> via AppVersion.Display: one source of truth. -->
                    <TextBlock Style="{StaticResource SecondaryTextStyle}"
                               Margin="4,0,0,8"
                               AutomationProperties.Name="Application version">
                        <Run Text="Version " /><Run Text="{x:Static app:AppVersion.Display}" />
                    </TextBlock>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="Settings"
                            AutomationProperties.Name="Open Settings"
                            Command="{Binding NavigateSettingsCommand}" />
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Right content area -->
        <ContentControl Grid.Column="1"
                        Margin="24"
                        Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
