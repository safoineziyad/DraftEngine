<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        High Contrast theme: every semantic brush maps to a Windows system color so the
        user's contrast scheme is respected instead of being overridden by brand colors.
        Applied automatically when SystemParameters.HighContrast is true.
    -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{x:Static SystemColors.ControlDarkColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{x:Static SystemColors.HotTrackColor}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="DiffAddedBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="DiffRemovedBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="DiffContextBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="NavActiveBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="{x:Static SystemColors.ControlDarkColor}" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="{x:Static SystemColors.InfoColor}" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="{x:Static SystemColors.InfoTextColor}" />
    <SolidColorBrush x:Key="RowAlternateBackgroundBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{x:Static SystemColors.InfoColor}" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="{x:Static SystemColors.ControlDarkColor}" />
    <SolidColorBrush x:Key="WarningForegroundBrush" Color="{x:Static SystemColors.InfoTextColor}" />
    <SolidColorBrush x:Key="DiffAddedForegroundBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="DiffRemovedForegroundBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="BadgeGeneratedBackgroundBrush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{x:Static SystemColors.ScrollBarColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{x:Static SystemColors.ControlDarkColor}" />
    <SolidColorBrush x:Key="TabSelectedForegroundBrush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="SuccessForegroundBrush" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="AccentMutedForegroundBrush" Color="{x:Static SystemColors.GrayTextColor}" />
</ResourceDictionary>
