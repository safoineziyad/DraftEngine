<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme. Every key here must exist in Dark.xaml with the same name. -->
    <Color x:Key="AccentColor">#1E3A8A</Color>
    <Color x:Key="AccentHoverColor">#1E40AF</Color>
    <Color x:Key="AccentLightColor">#DBEAFE</Color>
    <Color x:Key="SuccessColor">#166534</Color>
    <Color x:Key="DangerColor">#B91C1C</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4B5563" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="PanelBrush" Color="#F9FAFB" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#1E3A8A" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DiffAddedBrush" Color="#DCFCE7" />
    <SolidColorBrush x:Key="DiffRemovedBrush" Color="#FEE2E2" />
    <SolidColorBrush x:Key="DiffContextBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="NavActiveBrush" Color="#E8F0FE" />

    <!-- Control surfaces, inputs and popups -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#D1D5DB" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#DBEAFE" />
    <SolidColorBrush x:Key="SelectedForegroundBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#111827" />
    <SolidColorBrush x:Key="TooltipForegroundBrush" Color="#F9FAFB" />
    <SolidColorBrush x:Key="RowAlternateBackgroundBrush" Color="#F9FAFB" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFF4E5" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#FFB74D" />
    <SolidColorBrush x:Key="WarningForegroundBrush" Color="#8A4B00" />
    <SolidColorBrush x:Key="DiffAddedForegroundBrush" Color="#166534" />
    <SolidColorBrush x:Key="DiffRemovedForegroundBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#F0FDF4" />
    <SolidColorBrush x:Key="BadgeGeneratedBackgroundBrush" Color="#DCFCE7" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#C7CBD1" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="TabSelectedForegroundBrush" Color="#1E3A8A" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SuccessForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentMutedForegroundBrush" Color="#DCE7FF" />
</ResourceDictionary>
