<UserControl x:Class="DraftEngine.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:DraftEngine.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="BoolToVisInverse" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Version, help, privacy and licensing information."
                       Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,20" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="DraftEngine" FontWeight="SemiBold" FontSize="18"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding VersionText, StringFormat=Version {0}}"
                               Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,12" />
                    <TextBlock Text="DraftEngine drafts contracts locally from templates. Generation works fully offline and never requires an AI key."
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Open log folder" Padding="12,0" Height="30"
                                AutomationProperties.Name="Open the log folder"
                                Command="{Binding OpenLogFolderCommand}" />
                        <Button Content="Open data folder" Padding="12,0" Height="30" Margin="8,0,0,0"
                                AutomationProperties.Name="Open the data folder"
                                Command="{Binding OpenDataFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Diagnostics" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Version, Windows and .NET only. No contract data, paths or identifiers."
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,8" />
                    <TextBlock Text="{Binding DiagnosticsText}" Style="{StaticResource SecondaryTextStyle}"
                               TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Button Content="Copy diagnostics" HorizontalAlignment="Left"
                            Command="{Binding CopyDiagnosticsCommand}"
                            AutomationProperties.Name="Copy version and OS diagnostics" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Privacy summary" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Contracts, intake answers, chat history, settings and the API key stay on this computer and are encrypted with your Windows user profile. There is no telemetry, no account and no background upload."
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,6,0,6" />
                    <TextBlock Text="AI editing is optional. When you use it, the current contract text and your instruction are sent to the AI provider you configured. Enable 'Hide party names and addresses from AI' in Settings to replace real party details with tokens before sending."
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Updates" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding UpdateStatus}"
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,6,0,10" />
                    <Button Content="Check for updates" Padding="12,0" Height="30"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Check for updates"
                            Command="{Binding CheckForUpdatesCommand}"
                            IsEnabled="{Binding IsUpdateCheckEnabled}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}"
                    Visibility="{Binding IsLicensingEnabled, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="License" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding LicenseStatus}"
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,6,0,10" />
                    <TextBox Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="License key"
                             ToolTip="Paste the signed license key you received" />
                    <Button Content="Activate license" Padding="12,0" Height="30" Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Activate license"
                            Command="{Binding ActivateLicenseCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
