<UserControl x:Class="DraftEngine.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:DraftEngine.App.Services.Localization"
             xmlns:converters="clr-namespace:DraftEngine.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="BoolToVisInverse" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{loc:T About.Subtitle}"
                       Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,20" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="DraftEngine" FontWeight="SemiBold" FontSize="18"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding VersionText, StringFormat=Version {0}}"
                               Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,12" />
                    <TextBlock Text="{Binding BuildStampText}"
                               Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,12" />
                    <TextBlock Text="{loc:T About.Tagline}"
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{loc:T About.OpenLogs}" Padding="12,0" Height="30"
                                AutomationProperties.Name="{loc:T About.OpenLogs}"
                                Command="{Binding OpenLogFolderCommand}" />
                        <Button Content="{loc:T About.OpenData}" Padding="12,0" Height="30" Margin="8,0,0,0"
                                AutomationProperties.Name="{loc:T About.OpenData}"
                                Command="{Binding OpenDataFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:T About.Diagnostics}" FontWeight="SemiBold" FontSize="15"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{loc:T About.DiagnosticsDescription}"
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,8" />
                    <TextBlock Text="{Binding DiagnosticsText}" Style="{StaticResource SecondaryTextStyle}"
                               TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Button Content="{loc:T About.CopyDiagnostics}" HorizontalAlignment="Left"
                            Command="{Binding CopyDiagnosticsCommand}"
                            AutomationProperties.Name="{loc:T About.CopyDiagnosticsAutomation}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:T About.Privacy}" FontWeight="SemiBold" FontSize="15"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{loc:T About.PrivacyBody}"
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,6,0,6" />
                    <TextBlock Text="{loc:T About.AiPrivacyBody}"
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:T About.Updates}" FontWeight="SemiBold" FontSize="15"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Updates.StatusMessage}"
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,6,0,4" />
                    <TextBlock Text="{Binding Updates.LastCheckedText}"
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Updates.CurrentVersion, StringFormat={}{0}}"
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <Button Content="{loc:T About.CheckUpdates}" Padding="12,0" Height="30"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="{loc:T About.CheckUpdates}"
                            Command="{Binding Updates.CheckCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}"
                    Visibility="{Binding IsLicensingEnabled, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{loc:T About.License}" FontWeight="SemiBold" FontSize="15"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding LicenseStatus}"
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,6,0,10" />
                    <TextBox Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{loc:T About.LicenseKeyLabel}"
                             ToolTip="{loc:T About.LicenseKeyTooltip}" />
                    <Button Content="{loc:T About.ActivateLicense}" Padding="12,0" Height="30" Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="{loc:T About.ActivateLicense}"
                            Command="{Binding ActivateLicenseCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
