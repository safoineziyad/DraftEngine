<UserControl x:Class="DraftEngine.App.Views.AnalyzeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="0,0,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Review a contract against a playbook. Deterministic checks work offline; AI review is optional and consent-gated."
                       Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                <TextBlock Text="{Binding Disclaimer}" FontWeight="SemiBold"
                           Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: import, findings, history -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="1. Import a contract" FontWeight="SemiBold" FontSize="15"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="DOCX or text-based PDF. Scanned PDFs need OCR, which is not supported yet."
                                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,10" />

                            <TextBlock Text="Contract type (playbook)" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding ContractTypes}" DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedContractType}"
                                      AutomationProperties.Name="Playbook contract type" Margin="0,0,0,10" />

                            <WrapPanel>
                                <Button Content="Choose file..." Padding="12,0" Height="30"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ChooseFileCommand}"
                                        AutomationProperties.Name="Choose a contract file" />
                                <Button Content="Analyze" Padding="12,0" Height="30" Margin="8,0,0,0"
                                        Command="{Binding AnalyzeCommand}"
                                        IsEnabled="{Binding HasResult}"
                                        AutomationProperties.Name="Re-analyze the current file" />
                            </WrapPanel>

                            <TextBlock Text="{Binding CurrentFilePath}" Style="{StaticResource SecondaryTextStyle}"
                                       TextWrapping="Wrap" Margin="0,8,0,0" />

                            <CheckBox Content="AI review (optional)" IsChecked="{Binding UseAi}"
                                      IsEnabled="{Binding CanUseAi}" Margin="0,12,0,0"
                                      AutomationProperties.Name="Enable AI review" />
                            <TextBlock Text="{Binding AiConsentHint}" Style="{StaticResource SecondaryTextStyle}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />

                            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,0"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecondaryTextStyle}"
                                       TextWrapping="Wrap" Margin="0,10,0,0"
                                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding FindingCountText}" FontWeight="SemiBold" FontSize="15"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="Grouped by severity. Select a finding to highlight its quote."
                                       Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,8" />
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="Export report (DOCX)" Height="26" Padding="8,0"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Command="{Binding ExportReportCommand}" CommandParameter="docx" />
                                <Button Content="Export report (PDF)" Height="26" Padding="8,0" Margin="6,0,0,0"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Command="{Binding ExportReportCommand}" CommandParameter="pdf" />
                            </WrapPanel>

                            <ListBox ItemsSource="{Binding Findings}" SelectedItem="{Binding SelectedFinding}"
                                     MaxHeight="260" BorderThickness="0" Background="Transparent"
                                     AutomationProperties.Name="Review findings">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Border CornerRadius="3" Padding="5,1" Background="{StaticResource BorderSubtleBrush}">
                                                    <TextBlock Text="{Binding SeverityLabel}" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding Category}" Margin="6,0,0,0"
                                                           Style="{StaticResource SecondaryTextStyle}" />
                                                <TextBlock Text="AI" Margin="6,0,0,0" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           Visibility="{Binding IsAi, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Saved analyses" FontWeight="SemiBold" FontSize="15"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <Button Content="Refresh" Margin="10,0,0,0" Height="24" Padding="8,0"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Command="{Binding ReloadRecentCommand}" />
                                <Button Content="Archive selected" Margin="6,0,0,0" Height="24" Padding="8,0"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Command="{Binding ArchiveCurrentCommand}" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding RecentAnalyses}" SelectedItem="{Binding SelectedRecent}"
                                     MaxHeight="180" BorderThickness="0" Background="Transparent" Margin="0,8,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="{Binding FileName}" MinWidth="170" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding FindingCount}" Margin="8,0,0,0"
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                            <TextBlock Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd}" Margin="8,0,0,0"
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="Open selected analysis" HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Command="{Binding OpenRecentCommand}" CommandParameter="{Binding SelectedRecent}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: document viewer and selected finding -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Document" FontWeight="SemiBold" FontSize="15"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                    <TextBox x:Name="DocumentBox" Text="{Binding DocumentText, Mode=OneWay}"
                             IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0" Background="Transparent" Padding="12"
                             AutomationProperties.Name="Imported contract text" />
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0"
                        Visibility="{Binding SelectedFinding, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedFinding.Title}" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedFinding.Explanation}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="Suggested fix" FontWeight="SemiBold" Margin="0,8,0,2" />
                        <TextBlock Text="{Binding SelectedFinding.SuggestedFix}" TextWrapping="Wrap"
                                   Style="{StaticResource SecondaryTextStyle}" />
                        <Button Content="Copy suggested fix" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Command="{Binding CopySuggestedFixCommand}"
                                Visibility="{Binding SelectedFinding.HasFix, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
