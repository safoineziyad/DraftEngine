<UserControl x:Class="DraftEngine.App.Views.AnalyzeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:DraftEngine.App.Services.Localization" xmlns:converters="clr-namespace:DraftEngine.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="BoolToVisInverse" />
    </UserControl.Resources>

    <Grid Margin="0,0,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{loc:T Analyze.Subtitle}"
                       Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                <TextBlock Text="{Binding Disclaimer}" FontWeight="SemiBold"
                           Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: import, findings, history -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:T Analyze.ImportTitle}" FontWeight="SemiBold" FontSize="15"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:T Analyze.ImportDescription}"
                                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,10" />

                            <TextBlock Text="{loc:T Analyze.PlaybookLabel}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding ContractTypes}" DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedContractType}"
                                      AutomationProperties.Name="{loc:T Analyze.PlaybookAutomation}" Margin="0,0,0,10" />

                            <WrapPanel>
                                <Button Content="{loc:T Analyze.ChooseFile}" Padding="12,0" Height="30"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ChooseFileCommand}"
                                        AutomationProperties.Name="{loc:T Analyze.ChooseFileAutomation}" />
                                <Button Content="{loc:T Analyze.Analyze}" Padding="12,0" Height="30" Margin="8,0,0,0"
                                        Command="{Binding AnalyzeCommand}"
                                        IsEnabled="{Binding HasResult}"
                                        AutomationProperties.Name="{loc:T Analyze.AnalyzeAutomation}" />
                            </WrapPanel>

                            <TextBlock Text="{Binding CurrentFilePath}" Style="{StaticResource SecondaryTextStyle}"
                                       TextWrapping="Wrap" Margin="0,8,0,0" />

                            <CheckBox Content="{loc:T Analyze.AiReview}" IsChecked="{Binding UseAi}"
                                      IsEnabled="{Binding CanUseAi}" Margin="0,12,0,0"
                                      AutomationProperties.Name="{loc:T Analyze.AiReviewAutomation}" />
                            <TextBlock Text="{Binding AiConsentHint}" Style="{StaticResource SecondaryTextStyle}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />

                            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,0"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecondaryTextStyle}"
                                       TextWrapping="Wrap" Margin="0,10,0,0"
                                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding FindingCountText}" FontWeight="SemiBold" FontSize="15"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{loc:T Analyze.GroupedHint}"
                                       Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,8" />
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="{loc:T Analyze.ExportDocx}" Height="26" Padding="8,0"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Command="{Binding ExportReportCommand}" CommandParameter="docx" />
                                <Button Content="{loc:T Analyze.ExportPdf}" Height="26" Padding="8,0" Margin="6,0,0,0"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Command="{Binding ExportReportCommand}" CommandParameter="pdf" />
                            </WrapPanel>

                            <ListBox ItemsSource="{Binding Findings}" SelectedItem="{Binding SelectedFinding}"
                                     MaxHeight="260" BorderThickness="0" Background="Transparent"
                                     AutomationProperties.Name="{loc:T Analyze.FindingsAutomation}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Border CornerRadius="3" Padding="5,1" Background="{DynamicResource BorderSubtleBrush}">
                                                    <TextBlock Text="{Binding SeverityLabel}" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding Category}" Margin="6,0,0,0"
                                                           Style="{StaticResource SecondaryTextStyle}" />
                                                <TextBlock Text="{loc:T Analyze.AiBadge}" Margin="6,0,0,0" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Visibility="{Binding IsAi, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:T Analyze.Saved}" FontWeight="SemiBold" FontSize="15"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Button Content="{loc:T Analyze.Refresh}" Margin="10,0,0,0" Height="24" Padding="8,0"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Command="{Binding ReloadRecentCommand}" />
                                <Button Content="{loc:T Analyze.ArchiveSelected}" Margin="6,0,0,0" Height="24" Padding="8,0"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Command="{Binding ArchiveCurrentCommand}" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding RecentAnalyses}" SelectedItem="{Binding SelectedRecent}"
                                     MaxHeight="180" BorderThickness="0" Background="Transparent" Margin="0,8,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="{Binding FileName}" MinWidth="170" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding FindingCount}" Margin="8,0,0,0"
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                            <TextBlock Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd}" Margin="8,0,0,0"
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{loc:T Analyze.SavedEmpty}"
                                       Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0"
                                       Visibility="{Binding HasSavedAnalyses, Converter={StaticResource BoolToVisInverse}}" />
                            <Button Content="{loc:T Analyze.OpenSelected}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                    Command="{Binding OpenRecentCommand}" CommandParameter="{Binding SelectedRecent}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: document viewer and selected finding -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:T Analyze.Document}" FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <TextBox x:Name="DocumentBox" Text="{Binding DocumentText, Mode=OneWay}"
                                 IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 BorderThickness="0" Background="Transparent" Padding="12"
                                 AutomationProperties.Name="{loc:T Analyze.DocumentAutomation}" />
                        <TextBlock Text="{loc:T Analyze.DocumentEmpty}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Margin="12"
                                   Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisInverse}}" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0"
                        Visibility="{Binding SelectedFinding, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedFinding.Title}" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedFinding.Explanation}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{loc:T Analyze.SuggestedFix}" FontWeight="SemiBold" Margin="0,8,0,2" />
                        <TextBlock Text="{Binding SelectedFinding.SuggestedFix}" TextWrapping="Wrap"
                                   Style="{StaticResource SecondaryTextStyle}" />
                        <Button Content="{loc:T Analyze.CopyFix}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Command="{Binding CopySuggestedFixCommand}"
                                Visibility="{Binding SelectedFinding.HasFix, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
