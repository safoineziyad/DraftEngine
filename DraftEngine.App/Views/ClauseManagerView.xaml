<UserControl x:Class="DraftEngine.App.Views.ClauseManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:DraftEngine.App.Services.Localization"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{loc:T Clause.Subtitle}"
                       Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Clause list -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Border Grid.Row="0" Padding="16,12" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1" Background="{DynamicResource PanelBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="{loc:T Ui.ClauseFilterType}" Style="{StaticResource SecondaryTextStyle}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox Width="160" Margin="0,0,14,0"
                                      ItemsSource="{Binding ContractTypes}"
                                      SelectedItem="{Binding SelectedContractType, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="{loc:T Clause.FilterType}" />
                            <TextBlock Text="{loc:T Ui.ClauseFilterCategory}" Style="{StaticResource SecondaryTextStyle}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox Width="140" Margin="0,0,14,0"
                                      ItemsSource="{Binding CategoryFilters}"
                                      SelectedItem="{Binding SelectedCategoryFilter}"
                                      AutomationProperties.Name="{loc:T Clause.FilterCategory}" />
                            <TextBlock Text="{loc:T Ui.ClauseFilterSource}" Style="{StaticResource SecondaryTextStyle}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox Width="120"
                                      ItemsSource="{Binding SourceFilters}"
                                      SelectedItem="{Binding SelectedSourceFilter}"
                                      AutomationProperties.Name="{loc:T Clause.FilterSource}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{loc:T Clause.New}" Margin="8,0,0,0" Padding="12,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                AutomationProperties.Name="{loc:T Clause.NewAutomation}"
                                Command="{Binding NewClauseCommand}" />
                        <Button Grid.Column="2" Content="{loc:T Clause.Edit}" Margin="8,0,0,0" Padding="12,0"
                                AutomationProperties.Name="{loc:T Clause.EditAutomation}"
                                Command="{Binding EditClauseCommand}"
                                CommandParameter="{Binding SelectedClause}"
                                IsEnabled="{Binding CanEditSelected}" />
                        <Button Grid.Column="3" Content="{loc:T Clause.Duplicate}" Margin="8,0,0,0" Padding="12,0"
                                AutomationProperties.Name="{loc:T Clause.DuplicateAutomation}"
                                Command="{Binding DuplicateClauseCommand}"
                                CommandParameter="{Binding SelectedClause}"
                                IsEnabled="{Binding CanDuplicateSelected}" />
                        <Button Grid.Column="4" Content="{loc:T Clause.Archive}" Margin="8,0,0,0" Padding="12,0"
                                Foreground="{DynamicResource DangerBrush}"
                                AutomationProperties.Name="{loc:T Clause.ArchiveAutomation}"
                                Command="{Binding ArchiveClauseCommand}"
                                CommandParameter="{Binding SelectedClause}"
                                IsEnabled="{Binding CanArchiveSelected}" />
                    </Grid>
                </Border>

                <!-- Rows -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Column Headers -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1" Background="{DynamicResource PanelBrush}"
                            Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="180" />
                                <ColumnDefinition Width="1.5*" MinWidth="130" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:T Ui.ClauseColTitle}" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="1" Text="{loc:T Ui.ClauseColCategory}" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="2" Text="{loc:T Ui.ClauseColSource}" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="3" Text="{loc:T Ui.ClauseColOrder}" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="4" Text="{loc:T Ui.ClauseColOptional}" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}" />
                        </Grid>
                    </Border>

                    <ListView Grid.Row="1" ItemsSource="{Binding Clauses}"
                              SelectedItem="{Binding SelectedClause, Mode=TwoWay}"
                              AutomationProperties.Name="{loc:T Clause.ListAutomation}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="16,10" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" MinWidth="180" />
                                        <ColumnDefinition Width="1.5*" MinWidth="130" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                               Margin="0,0,12,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Category}"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Source}"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                                    <TextBlock Grid.Column="3" Text="{Binding SortOrder}"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                                Background="{DynamicResource PanelBrush}"
                                                Visibility="{Binding IsOptional, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{loc:T Wizard.Optional}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty state -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasNoClauses, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:T Clause.Empty}"
                                   Style="{StaticResource BodyTextStyle}" FontSize="15"
                                   HorizontalAlignment="Center" />
                        <Button Content="{loc:T Clause.NewLong}" Style="{StaticResource PrimaryButtonStyle}"
                                AutomationProperties.Name="{loc:T Clause.NewAutomation}"
                                Command="{Binding NewClauseCommand}"
                                HorizontalAlignment="Center" Margin="0,16,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Edit form -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16"
                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T Clause.TitleLabel}" Style="{StaticResource BodyTextStyle}"
                           VerticalAlignment="Center" Margin="0,0,0,4" />
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,12"
                         Text="{Binding SelectedClause.Title, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{loc:T Clause.TitleAutomation}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:T Clause.CategoryLabel}" Style="{StaticResource BodyTextStyle}"
                           VerticalAlignment="Center" Margin="0,0,0,4" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"
                         Text="{Binding SelectedClause.Category, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{loc:T Clause.CategoryAutomation}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:T Clause.BodyLabel}" Style="{StaticResource BodyTextStyle}"
                           VerticalAlignment="Top" Margin="0,0,0,4" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,12"
                         Text="{Binding SelectedClause.BodyTemplate, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{loc:T Clause.BodyAutomation}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="140" VerticalScrollBarVisibility="Auto" />

                <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,12"
                          IsChecked="{Binding SelectedClause.IsOptional}"
                          Content="{loc:T Clause.Optional}" AutomationProperties.Name="{loc:T Clause.OptionalAutomation}" />

                <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,8"
                           Text="{Binding PlaceholderWarning}" Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasPlaceholderWarning, Converter={StaticResource BoolToVis}}" />

                <!-- Action bar -->
                <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:T Clause.Cancel}" Margin="8,0,0,0" Padding="12,0"
                            AutomationProperties.Name="{loc:T Clause.CancelAutomation}"
                            Command="{Binding CancelEditCommand}" />
                    <Button Content="{loc:T Clause.Save}" Margin="8,0,0,0" Padding="12,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            AutomationProperties.Name="{loc:T Clause.SaveAutomation}"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding CanSave}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Error banner -->
        <StackPanel Grid.Row="3" Margin="16" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource DangerBrush}" CornerRadius="6" Padding="12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerForegroundBrush}"
                               VerticalAlignment="Center" />
                    <Button Content="{loc:T Clause.TryAgain}" Height="28" Padding="10,0" FontSize="12"
                            Margin="12,0,0,0"
                            AutomationProperties.Name="{loc:T Clause.TryAgainAutomation}"
                            Command="{Binding LoadCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
