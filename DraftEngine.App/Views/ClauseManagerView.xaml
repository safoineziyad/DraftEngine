<UserControl x:Class="DraftEngine.App.Views.ClauseManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Create, edit and archive your clause templates."
                       Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Clause list -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Border Grid.Row="0" Padding="16,12" BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1" Background="{StaticResource PanelBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <ComboBox Width="180" Margin="0,0,8,0"
                                      ItemsSource="{Binding ContractTypes}"
                                      SelectedItem="{Binding SelectedContractType, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="Filter clauses by contract type" />
                            <ComboBox Width="150" Margin="0,0,8,0"
                                      ItemsSource="{Binding CategoryFilters}"
                                      SelectedItem="{Binding SelectedCategoryFilter}"
                                      AutomationProperties.Name="Filter clauses by category" />
                            <ComboBox Width="120"
                                      ItemsSource="{Binding SourceFilters}"
                                      SelectedItem="{Binding SelectedSourceFilter}"
                                      AutomationProperties.Name="Filter clauses by source" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="+ New" Margin="8,0,0,0" Padding="12,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                AutomationProperties.Name="Create a new clause"
                                Command="{Binding NewClauseCommand}" />
                        <Button Grid.Column="2" Content="Edit" Margin="8,0,0,0" Padding="12,0"
                                AutomationProperties.Name="Edit the selected clause"
                                Command="{Binding EditClauseCommand}"
                                CommandParameter="{Binding SelectedClause}"
                                IsEnabled="{Binding CanEditSelected}" />
                        <Button Grid.Column="3" Content="Duplicate" Margin="8,0,0,0" Padding="12,0"
                                AutomationProperties.Name="Duplicate the selected clause"
                                Command="{Binding DuplicateClauseCommand}"
                                CommandParameter="{Binding SelectedClause}"
                                IsEnabled="{Binding CanDuplicateSelected}" />
                        <Button Grid.Column="4" Content="Archive" Margin="8,0,0,0" Padding="12,0"
                                Foreground="{StaticResource DangerBrush}"
                                AutomationProperties.Name="Archive the selected clause"
                                Command="{Binding ArchiveClauseCommand}"
                                CommandParameter="{Binding SelectedClause}"
                                IsEnabled="{Binding CanArchiveSelected}" />
                    </Grid>
                </Border>

                <!-- Rows -->
                <ListView Grid.Row="1" ItemsSource="{Binding Clauses}"
                          SelectedItem="{Binding SelectedClause, Mode=TwoWay}"
                          AutomationProperties.Name="Clause list">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="16,10" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                <TextBlock Grid.Column="1" Text="{Binding Category}"
                                           VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Source}"
                                           VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="8,0,0,0"
                                           Style="{StaticResource SecondaryTextStyle}" FontSize="11">
                                    <Run Text="{Binding SortOrder}" />
                                    <Run Text="{Binding IsOptional, StringFormat=' optional'}" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty state -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasNoClauses, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="No clauses yet — create your first one."
                               Style="{StaticResource BodyTextStyle}" FontSize="15"
                               HorizontalAlignment="Center" />
                    <Button Content="+ New Clause" Style="{StaticResource PrimaryButtonStyle}"
                            AutomationProperties.Name="Create a new clause"
                            Command="{Binding NewClauseCommand}"
                            HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Edit form -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16"
                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Title" Style="{StaticResource BodyTextStyle}"
                           VerticalAlignment="Center" Margin="0,0,0,4" />
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,12"
                         Text="{Binding SelectedClause.Title, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Clause title" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Category" Style="{StaticResource BodyTextStyle}"
                           VerticalAlignment="Center" Margin="0,0,0,4" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"
                         Text="{Binding SelectedClause.Category, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Clause category" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Body template" Style="{StaticResource BodyTextStyle}"
                           VerticalAlignment="Top" Margin="0,0,0,4" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,12"
                         Text="{Binding SelectedClause.BodyTemplate, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Clause body template"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="140" VerticalScrollBarVisibility="Auto" />

                <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,12"
                          IsChecked="{Binding SelectedClause.IsOptional}"
                          Content="Optional clause" AutomationProperties.Name="Mark clause as optional" />

                <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,8"
                           Text="{Binding PlaceholderWarning}" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasPlaceholderWarning, Converter={StaticResource BoolToVis}}" />

                <!-- Action bar -->
                <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Margin="8,0,0,0" Padding="12,0"
                            AutomationProperties.Name="Discard changes"
                            Command="{Binding CancelEditCommand}" />
                    <Button Content="Save" Margin="8,0,0,0" Padding="12,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            AutomationProperties.Name="Save clause"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding CanSave}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Error banner -->
        <StackPanel Grid.Row="3" Margin="16" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource DangerBrush}" CornerRadius="6" Padding="12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="White"
                               VerticalAlignment="Center" />
                    <Button Content="Try again" Height="28" Padding="10,0" FontSize="12"
                            Margin="12,0,0,0"
                            AutomationProperties.Name="Retry loading clauses"
                            Command="{Binding LoadCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
