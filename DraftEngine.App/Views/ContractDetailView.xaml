<UserControl x:Class="DraftEngine.App.Views.ContractDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:DraftEngine.App.Converters"
             xmlns:loc="clr-namespace:DraftEngine.App.Services.Localization"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="BoolToVisInverse" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: contract title, metadata and document actions -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding ContractTypeDisplayName}" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Text="{loc:T ContractDetail.MetadataSeparator}" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Text="{Binding ContractStatusDisplayName}" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Text="{Binding ClientLabel}" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Text="{Binding Contract.ClientName}" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{loc:T ContractDetail.SaveRegenerate}" Padding="14,0" Height="34" Margin="8,0,0,0"
                        AutomationProperties.Name="{loc:T ContractDetail.SaveRegenerateAutomation}"
                        AutomationProperties.HelpText="{loc:T ContractDetail.SaveRegenerateHelp}"
                        Command="{Binding RegenerateCommand}"
                        IsEnabled="{Binding CanSaveAndRegenerate}" />
                <CheckBox Margin="12,0,0,0" VerticalAlignment="Center"
                          Content="{loc:T ContractDetail.AiPolish}"
                          IsChecked="{Binding UseAiPolish}"
                          IsEnabled="{Binding CanEditContract}"
                          AutomationProperties.Name="{loc:T ContractDetail.AiPolishAutomation}"
                          Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button Content="{loc:T ContractDetail.ExportDocx}" Padding="14,0" Height="34" Margin="8,0,0,0"
                        AutomationProperties.Name="{loc:T ContractDetail.ExportDocxAutomation}"
                        Command="{Binding ExportDocxCommand}"
                        IsEnabled="{Binding HasDocument}" />
                <Button Content="{loc:T ContractDetail.ExportPdf}" Padding="14,0" Height="34" Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        AutomationProperties.Name="{loc:T ContractDetail.ExportPdfAutomation}"
                        Command="{Binding ExportPdfCommand}"
                        IsEnabled="{Binding HasDocument}" />
            </StackPanel>
        </Grid>

        <!-- Error banner -->
        <Border Grid.Row="1" Background="{DynamicResource DangerBrush}" CornerRadius="6"
                Padding="12" Margin="0,0,0,12"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="White" TextWrapping="Wrap" />
        </Border>

        <!-- Success banner -->
        <Border Grid.Row="2" Background="{DynamicResource SuccessBrush}" CornerRadius="6"
                Padding="12" Margin="0,0,0,12"
                Visibility="{Binding HasInfo, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding InfoMessage}" Foreground="White" TextWrapping="Wrap" />
        </Border>

        <!-- Main content: document panel + AI chat panel -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="360" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Document panel -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="{loc:T ContractDetail.DocumentHeading}" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:T ContractDetail.DocumentHint}"
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>

                    <!-- Edit staged metadata, registry-defined intake and clause selection. -->
                    <Expander Grid.Row="1" Margin="0,0,0,10" IsExpanded="True"
                              IsEnabled="{Binding CanEditContract}"
                              AutomationProperties.Name="{loc:T ContractDetail.EditAutomation}">
                        <Expander.Header>
                            <TextBlock Text="{loc:T ContractDetail.EditDetails}" FontWeight="SemiBold" />
                        </Expander.Header>
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:T ContractDetail.ContractTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{loc:T ContractDetail.ContractTitle}" Margin="0,0,0,10" />
                                <Button Content="{loc:T ContractDetail.Duplicate}" Padding="12,0" Height="30"
                                        HorizontalAlignment="Left" Margin="0,0,0,12"
                                        AutomationProperties.Name="{loc:T ContractDetail.DuplicateAutomation}"
                                        Command="{Binding DuplicateContractCommand}" />

                                <ItemsControl ItemsSource="{Binding IntakeFields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" Margin="0,0,10,0" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding IsTextInput, Converter={StaticResource BoolToVis}}"
                                                         AutomationProperties.Name="{Binding Label}" />
                                                <DatePicker Grid.Column="1"
                                                            SelectedDate="{Binding DateValue, UpdateSourceTrigger=PropertyChanged}"
                                                            Visibility="{Binding IsDateInput, Converter={StaticResource BoolToVis}}"
                                                            AutomationProperties.Name="{Binding Label}" />
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}"
                                                          SelectedItem="{Binding SelectedChoice, UpdateSourceTrigger=PropertyChanged}"
                                                          Visibility="{Binding IsChoiceInput, Converter={StaticResource BoolToVis}}"
                                                          AutomationProperties.Name="{Binding Label}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding SelectedClauseCountText}"
                                           FontWeight="SemiBold" Margin="0,4,0,6" />
                                <ItemsControl ItemsSource="{Binding ClauseGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Category}" FontWeight="SemiBold"
                                                           Style="{StaticResource SecondaryTextStyle}" />
                                                <ItemsControl ItemsSource="{Binding Clauses}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Title}"
                                                                      IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                                      ToolTip="{Binding PreviewText}"
                                                                      AutomationProperties.Name="{Binding Title}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Expander>

                    <!-- Version history: snapshots taken automatically before AI edits and regenerations -->
                    <Expander Grid.Row="2" Margin="0,0,0,10"
                              IsExpanded="{Binding IsHistoryVisible}"
                              AutomationProperties.Name="{loc:T ContractDetail.VersionHistory}">
                        <Expander.Header>
                            <TextBlock Text="{Binding VersionHistoryHeader}" FontWeight="SemiBold" />
                        </Expander.Header>
                        <Grid Margin="0,6,0,2">
                            <TextBlock Text="{loc:T ContractDetail.VersionEmpty}"
                                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                       Visibility="{Binding IsVersionHistoryEmpty, Converter={StaticResource BoolToVis}}" />
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding IsVersionHistoryEmpty, Converter={StaticResource BoolToVisInverse}}">
                                <ItemsControl ItemsSource="{Binding Versions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding VersionLabel}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding DetailsLabel}"
                                                           Style="{StaticResource SecondaryTextStyle}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="2" Content="{loc:T ContractDetail.Restore}" Padding="10,2" Margin="8,0,0,0"
                                                        AutomationProperties.Name="{Binding RestoreAutomationName}"
                                                        Command="{Binding DataContext.RevertToVersionCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding VersionId}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Expander>

                    <!-- Export history: every recorded DOCX/PDF export for this contract -->
                    <Expander Grid.Row="3" Margin="0,0,0,10"
                              IsExpanded="{Binding IsExportHistoryVisible}"
                              AutomationProperties.Name="{loc:T ContractDetail.ExportHistory}">
                        <Expander.Header>
                            <TextBlock Text="{Binding ExportHistoryHeader}" FontWeight="SemiBold" />
                        </Expander.Header>
                        <Grid Margin="0,6,0,2">
                            <TextBlock Text="{loc:T ContractDetail.ExportHistoryEmpty}"
                                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                       Visibility="{Binding IsExportHistoryEmpty, Converter={StaticResource BoolToVis}}" />
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding IsExportHistoryEmpty, Converter={StaticResource BoolToVisInverse}}">
                                <ItemsControl ItemsSource="{Binding ExportHistory}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2" ToolTip="{Binding FilePath}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TypeLabel}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                                           Style="{StaticResource SecondaryTextStyle}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding ExportedLabel}"
                                                               Style="{StaticResource SecondaryTextStyle}"
                                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding StatusLabel}"
                                                               Style="{StaticResource SecondaryTextStyle}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Expander>

                    <TextBox Grid.Row="4"
                             Text="{Binding DocumentText, Mode=OneWay}"
                             IsReadOnly="True"
                             AutomationProperties.Name="{loc:T ContractDetail.DocumentAutomation}"
                             AutomationProperties.HelpText="{loc:T ContractDetail.DocumentHelp}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             FontFamily="{StaticResource DocumentFontFamily}"
                             FontSize="14"
                             Padding="16" />

                    <!-- Busy overlay -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <ProgressBar IsIndeterminate="True" Width="180" Height="4" />
                        <TextBlock Text="{loc:T ContractDetail.Working}" Style="{StaticResource SecondaryTextStyle}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- AI chat panel -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{loc:T ContractDetail.AiAssistant}" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:T ContractDetail.AiSubtitle}"
                                   Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Chat history -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Empty hint -->
                            <TextBlock Text="{loc:T ContractDetail.ChatExample}"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       TextWrapping="Wrap" Margin="0,8"
                                       Visibility="{Binding IsChatEmpty, Converter={StaticResource BoolToVis}}" />

                            <ItemsControl ItemsSource="{Binding ChatMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Border CornerRadius="10" Padding="12,8" MaxWidth="280"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource PanelBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                                        <Setter Property="Foreground" Value="White" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding TimeLabel}" FontSize="10" Margin="0,4,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                                        <Setter Property="Foreground" Value="#DCE7FF" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- AI edit diff: Accept/Reject before anything is stored -->
                    <Border Grid.Row="2" Margin="0,8,0,8" Padding="10" CornerRadius="6"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                            Visibility="{Binding HasPendingAiEdit, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{loc:T ContractDetail.ProposedAiEdit}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PendingAiEditSummary}"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       TextWrapping="Wrap" Margin="0,2,0,6" />
                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding DiffLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Prefix}" FontFamily="Consolas" FontSize="11" />
                                                <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="11"
                                                           TextWrapping="Wrap" MaxWidth="310">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                                    <Setter Property="Foreground" Value="#1B5E20" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                                                                    <Setter Property="Foreground" Value="#B71C1C" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="{loc:T ContractDetail.Accept}" Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="14,4" MinWidth="80"
                                        AutomationProperties.Name="{loc:T ContractDetail.AcceptAutomation}"
                                        Command="{Binding AcceptAiEditCommand}"
                                        IsEnabled="{Binding CanReviewAiEdit}" />
                                <Button Content="{loc:T ContractDetail.Reject}" Padding="14,4" MinWidth="80" Margin="8,0,0,0"
                                        AutomationProperties.Name="{loc:T ContractDetail.RejectAutomation}"
                                        Command="{Binding RejectAiEditCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- API key warning -->
                    <Border Grid.Row="3" Margin="0,8,0,8" Padding="10,8"
                            Background="#FFF4E5" CornerRadius="6" BorderBrush="#FFB74D" BorderThickness="1"
                            Visibility="{Binding ShowApiKeyWarning, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{loc:T ContractDetail.ApiKeyWarning}"
                                       TextWrapping="Wrap" Foreground="#E65100" FontSize="12" />
                            <Button Content="{loc:T ContractDetail.GoToSettings}" Margin="0,6,0,0" Padding="10,4" HorizontalAlignment="Left"
                                    Command="{Binding GoToSettingsCommand}" FontSize="11" />
                        </StackPanel>
                    </Border>

                    <!-- Input -->
                    <Grid Grid.Row="4" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatBox"
                                 Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{loc:T ContractDetail.ChatAutomation}"
                                 AutomationProperties.HelpText="{loc:T ContractDetail.ChatHelp}"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                                 VerticalContentAlignment="Top" Padding="8"
                                 VerticalScrollBarVisibility="Auto"
                                 IsEnabled="{Binding HasApiKey}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SendChatEditCommand}" />
                            </TextBox.InputBindings>
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Grid.Column="1" Content="{loc:T ContractDetail.Send}" Width="70" Height="60" Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                AutomationProperties.Name="{loc:T ContractDetail.SendAutomation}"
                                Command="{Binding SendChatEditCommand}"
                                IsEnabled="{Binding CanChat}">
                            <Button.ToolTip>
                                <ToolTip Content="{loc:T ContractDetail.ApiKeyWarning}"
                                         Visibility="{Binding ShowApiKeyWarning, Converter={StaticResource BoolToVis}}" />
                            </Button.ToolTip>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Load-failed state replaces the whole body -->
            <Border Grid.ColumnSpan="2" Style="{StaticResource Card}"
                    Visibility="{Binding LoadFailed, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding LoadFailedMessage}" Style="{StaticResource BodyTextStyle}"
                               TextWrapping="Wrap" HorizontalAlignment="Center" />
                    <Button Content="{loc:T ContractDetail.BackToContracts}" Style="{StaticResource PrimaryButtonStyle}"
                            AutomationProperties.Name="{loc:T ContractDetail.BackAutomation}"
                            Command="{Binding BackToListCommand}"
                            HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
