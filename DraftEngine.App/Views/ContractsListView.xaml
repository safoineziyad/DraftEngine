<UserControl x:Class="DraftEngine.App.Views.ContractsListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Local badge colors (light tints not present in the shared theme). -->
        <SolidColorBrush x:Key="BadgeGeneratedBg" Color="#DCFCE7" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title + New Contract -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Search, review and manage your saved contracts."
                           Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="+ New Contract"
                    Style="{StaticResource PrimaryButtonStyle}"
                    AutomationProperties.Name="Start a new contract"
                    Command="{Binding NewContractCommand}"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- Toolbar: search, type filter, sort -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search contracts by title or client" />
                    <TextBlock Text="Search by title or client…"
                               Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="Type" Style="{StaticResource SecondaryTextStyle}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="160"
                              ItemsSource="{Binding TypeFilters}"
                              SelectedItem="{Binding SelectedTypeFilter}"
                              AutomationProperties.Name="Filter by contract type" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Sort" Style="{StaticResource SecondaryTextStyle}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="160"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSortMode}"
                              AutomationProperties.Name="Sort contracts" />
                    <Button Content="Clear filters" Margin="12,0,0,0" Padding="12,0" Height="34"
                            AutomationProperties.Name="Clear all filters and sorting"
                            ToolTip="Reset search, type filter and sort to defaults"
                            Command="{Binding ClearFiltersCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActiveFilters}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contract table -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header row -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1"
                            Background="{StaticResource PanelBrush}"
                            Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" SharedSizeGroup="ColTitle" />
                                <ColumnDefinition Width="1.2*" SharedSizeGroup="ColType" />
                                <ColumnDefinition Width="110" SharedSizeGroup="ColStatus" />
                                <ColumnDefinition Width="120" SharedSizeGroup="ColEffective" />
                                <ColumnDefinition Width="90" SharedSizeGroup="ColTerm" />
                                <ColumnDefinition Width="120" SharedSizeGroup="ColUpdated" />
                                <ColumnDefinition Width="150" SharedSizeGroup="ColActions" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Title" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Grid.Column="1" Text="Contract type" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Grid.Column="2" Text="Status" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Grid.Column="3" Text="Effective date" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Grid.Column="4" Text="Term" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Grid.Column="5" Text="Updated" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Grid.Column="6" Text="" />
                        </Grid>
                    </Border>

                    <!-- Rows -->
                    <ItemsControl Grid.Row="1" Margin="0,4,0,0" ItemsSource="{Binding Contracts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,10" BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" SharedSizeGroup="ColTitle" />
                                            <ColumnDefinition Width="1.2*" SharedSizeGroup="ColType" />
                                            <ColumnDefinition Width="110" SharedSizeGroup="ColStatus" />
                                            <ColumnDefinition Width="120" SharedSizeGroup="ColEffective" />
                                            <ColumnDefinition Width="90" SharedSizeGroup="ColTerm" />
                                            <ColumnDefinition Width="120" SharedSizeGroup="ColUpdated" />
                                            <ColumnDefinition Width="150" SharedSizeGroup="ColActions" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                                   ToolTip="{Binding Title}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ContractType}"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                                   TextTrimming="CharacterEllipsis" />

                                        <!-- Status badge -->
                                        <Border Grid.Column="2" CornerRadius="10" Padding="10,3"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource AccentLightBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Generated">
                                                            <Setter Property="Background" Value="{StaticResource BadgeGeneratedBg}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Exported">
                                                            <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Exported">
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Text="{Binding EffectiveDate, StringFormat={}{0:MMM d, yyyy}}" />
                                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Text="{Binding TermMonths, StringFormat={}{0} months}" />
                                        <TextBlock Grid.Column="5" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   Text="{Binding UpdatedAt, StringFormat={}{0:MMM d, yyyy}}" />

                                        <!-- Row actions -->
                                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Open" Padding="12,0" Height="30" FontSize="12"
                                                    AutomationProperties.Name="{Binding Title, StringFormat=Open contract {0}}"
                                                    Command="{Binding DataContext.OpenContractCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Delete" Padding="12,0" Height="30" FontSize="12"
                                                    Margin="8,0,0,0"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    AutomationProperties.Name="{Binding Title, StringFormat=Delete contract {0}}"
                                                    Command="{Binding DataContext.DeleteCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Loading indicator -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="4" />
                    <TextBlock Text="Loading contracts…" Style="{StaticResource SecondaryTextStyle}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>

                <!-- Error banner -->
                <StackPanel VerticalAlignment="Top" Margin="16"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <Border Background="{StaticResource DangerBrush}" CornerRadius="6" Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="White"
                                       VerticalAlignment="Center" />
                            <Button Content="Try again" Height="28" Padding="10,0" FontSize="12"
                                    Margin="12,0,0,0"
                                    AutomationProperties.Name="Retry loading contracts"
                                    Command="{Binding LoadCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Empty state: no contracts at all -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="No contracts yet — create your first one."
                               Style="{StaticResource BodyTextStyle}" FontSize="15"
                               HorizontalAlignment="Center" />
                    <Button Content="+ New Contract" Style="{StaticResource PrimaryButtonStyle}"
                            AutomationProperties.Name="Start a new contract"
                            Command="{Binding NewContractCommand}"
                            HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>

                <!-- Empty state: filters hid everything -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="No contracts match your search."
                               Style="{StaticResource BodyTextStyle}" FontSize="15" />
                    <TextBlock Text="Try a different search term or select another contract type."
                               Style="{StaticResource SecondaryTextStyle}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
