<UserControl x:Class="DraftEngine.App.Views.ContractsListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:DraftEngine.App.Services.Localization"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: title + New Contract -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{loc:T Contracts.Subtitle}"
                           Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="{loc:T Contracts.NewContractPlus}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    AutomationProperties.Name="{loc:T Nav.NewContractAutomation}"
                    Command="{Binding NewContractCommand}"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- Toolbar: search, type filter, sort -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{loc:T Contracts.SearchAutomation}" />
                    <TextBlock Text="{loc:T Contracts.SearchPlaceholder}"
                               Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock Text="{loc:T Contracts.Type}" Style="{StaticResource SecondaryTextStyle}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="160"
                              ItemsSource="{Binding TypeFilters}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedTypeFilterId}"
                              AutomationProperties.Name="{loc:T Contracts.FilterTypeAutomation}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="{loc:T Contracts.Sort}" Style="{StaticResource SecondaryTextStyle}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="160"
                              ItemsSource="{Binding SortOptions}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedSortModeId}"
                              AutomationProperties.Name="{loc:T Contracts.SortAutomation}" />
                    <Button Content="{loc:T Contracts.ClearFilters}" Margin="12,0,0,0" Padding="12,0" Height="34"
                            AutomationProperties.Name="{loc:T Contracts.ClearFiltersAutomation}"
                            ToolTip="{loc:T Contracts.ClearFiltersTooltip}"
                            Command="{Binding ClearFiltersCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActiveFilters}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contract table -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header row -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1"
                            Background="{DynamicResource PanelBrush}"
                            Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" SharedSizeGroup="ColTitle" />
                                <ColumnDefinition Width="1.2*" SharedSizeGroup="ColType" />
                                <ColumnDefinition Width="110" SharedSizeGroup="ColStatus" />
                                <ColumnDefinition Width="120" SharedSizeGroup="ColEffective" />
                                <ColumnDefinition Width="90" SharedSizeGroup="ColTerm" />
                                <ColumnDefinition Width="120" SharedSizeGroup="ColUpdated" />
                                <ColumnDefinition Width="220" SharedSizeGroup="ColActions" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:T Contracts.ColumnTitle}" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Grid.Column="1" Text="{loc:T Contracts.ColumnType}" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Grid.Column="2" Text="{loc:T Contracts.ColumnStatus}" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Grid.Column="3" Text="{loc:T Contracts.ColumnEffective}" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Grid.Column="4" Text="{loc:T Contracts.ColumnTerm}" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Grid.Column="5" Text="{loc:T Contracts.ColumnUpdated}" FontWeight="SemiBold" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Grid.Column="6" Text="" />
                        </Grid>
                    </Border>

                    <!-- Rows -->
                    <ItemsControl Grid.Row="1" Margin="0,4,0,0" ItemsSource="{Binding Contracts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="16,10" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" SharedSizeGroup="ColTitle" />
                                            <ColumnDefinition Width="1.2*" SharedSizeGroup="ColType" />
                                            <ColumnDefinition Width="110" SharedSizeGroup="ColStatus" />
                                            <ColumnDefinition Width="120" SharedSizeGroup="ColEffective" />
                                            <ColumnDefinition Width="90" SharedSizeGroup="ColTerm" />
                                            <ColumnDefinition Width="120" SharedSizeGroup="ColUpdated" />
                                            <ColumnDefinition Width="220" SharedSizeGroup="ColActions" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                                   ToolTip="{Binding Title}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ContractType}"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                                   TextTrimming="CharacterEllipsis" />

                                        <!-- Status badge -->
                                        <Border Grid.Column="2" CornerRadius="10" Padding="10,3"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Generated">
                                                            <Setter Property="Background" Value="{DynamicResource BadgeGeneratedBackgroundBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Exported">
                                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Exported">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Text="{Binding EffectiveDateText}" />
                                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Text="{Binding TermMonthsText}" />
                                        <TextBlock Grid.Column="5" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   Text="{Binding UpdatedDateText}" />

                                        <!-- Row actions -->
                                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{loc:T Common.Open}" Padding="12,0" Height="30" FontSize="12"
                                                    AutomationProperties.Name="{Binding OpenAutomationName}"
                                                    Command="{Binding DataContext.OpenContractCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Contract}" />
                                            <Button Content="{loc:T Common.Duplicate}" Padding="10,0" Height="30" FontSize="12"
                                                    Margin="6,0,0,0"
                                                    AutomationProperties.Name="{Binding DuplicateAutomationName}"
                                                    Command="{Binding DataContext.DuplicateCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Contract}" />
                                            <Button Content="{loc:T Common.Delete}" Padding="12,0" Height="30" FontSize="12"
                                                    Margin="6,0,0,0"
                                                    Foreground="{DynamicResource DangerBrush}"
                                                    AutomationProperties.Name="{Binding DeleteAutomationName}"
                                                    Command="{Binding DataContext.DeleteCommand,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Contract}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Loading indicator -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="4" />
                    <TextBlock Text="{loc:T Contracts.Loading}" Style="{StaticResource SecondaryTextStyle}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>

                <!-- Error banner -->
                <StackPanel VerticalAlignment="Top" Margin="16"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <Border Background="{DynamicResource DangerBrush}" CornerRadius="6" Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerForegroundBrush}"
                                       VerticalAlignment="Center" />
                            <Button Content="{loc:T Contracts.TryAgain}" Height="28" Padding="10,0" FontSize="12"
                                    Margin="12,0,0,0"
                                    AutomationProperties.Name="{loc:T Contracts.RetryAutomation}"
                                    Command="{Binding LoadCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Empty state: no contracts at all -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:T Contracts.Empty}"
                               Style="{StaticResource BodyTextStyle}" FontSize="15"
                               HorizontalAlignment="Center" />
                    <Button Content="{loc:T Contracts.NewContractPlus}" Style="{StaticResource PrimaryButtonStyle}"
                            AutomationProperties.Name="{loc:T Nav.NewContractAutomation}"
                            Command="{Binding NewContractCommand}"
                            HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>

                <!-- Empty state: filters hid everything -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsFilteredEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:T Contracts.NoMatch}"
                               Style="{StaticResource BodyTextStyle}" FontSize="15" />
                    <TextBlock Text="{loc:T Contracts.NoMatchHint}"
                               Style="{StaticResource SecondaryTextStyle}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
