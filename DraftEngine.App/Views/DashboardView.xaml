<UserControl x:Class="DraftEngine.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:DraftEngine.App.Services.Localization"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Status badge: neutral by default, accent for Generated, green for Exported. -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGenerated}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExported}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Contract row: full-width quiet button with subtle hover. -->
        <Style x:Key="ContractRowStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource PanelBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{loc:T Dashboard.Subtitle}"
                               Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{loc:T Nav.NewContract}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        AutomationProperties.Name="{loc:T Nav.NewContractAutomation}"
                        Command="{Binding NewContractCommand}"
                        VerticalAlignment="Center"
                        MinWidth="140" />
            </Grid>

            <!-- Stats cards -->
            <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,20">
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{loc:T Dashboard.ContractsCreated}" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding ContractCount}"
                                   FontSize="28" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="20" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:T Dashboard.EstimatedTimeSaved}" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock FontSize="28" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,6,0,0">
                            <Run Text="{Binding HoursSavedEstimate, Mode=OneWay}" />
                            <Run Text="{loc:T Common.HoursShort}" FontSize="16" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Error banner: shown when loading fails, above the recent contracts area -->
            <Border Grid.Row="2" Margin="0,0,0,16" Padding="12"
                    Background="{DynamicResource DangerBrush}" CornerRadius="6"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerForegroundBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
            </Border>

            <!-- Recent contracts -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="24,20,24,12">
                        <TextBlock Text="{loc:T Dashboard.RecentContracts}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Run Text="{Binding ContractCount, Mode=OneWay}" />
                            <Run Text="{loc:T Dashboard.Total}" />
                        </TextBlock>
                    </Grid>

                    <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderSubtleBrush}"
                            Margin="24,0" />

                    <!-- Contract rows -->
                    <ItemsControl Grid.Row="2" Margin="16,8,16,16"
                                  ItemsSource="{Binding RecentContracts}"
                                  Visibility="{Binding HasContracts, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ContractRowStyle}"
                                        AutomationProperties.Name="{Binding OpenAutomationName}"
                                        Command="{Binding DataContext.OpenContractCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ContractType}"
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource StatusBadgeStyle}"
                                                Margin="16,0">
                                            <TextBlock Text="{Binding StatusText}" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                        <Setter Property="FontWeight" Value="Medium" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGenerated}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsExported}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding UpdatedAtText}"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="3" Text="{loc:T Common.ChevronRight}"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <StackPanel Grid.Row="2" Margin="24,24,24,28"
                                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:T Dashboard.NoContracts}"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{loc:T Dashboard.EmptyStateDescription}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,4,0,14" TextWrapping="Wrap" />
                        <Button Content="{loc:T Nav.NewContract}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                AutomationProperties.Name="{loc:T Nav.NewContractAutomation}"
                                Command="{Binding NewContractCommand}"
                                HorizontalAlignment="Left"
                                MinWidth="140" />
                    </StackPanel>

                    <!-- Loading -->
                    <TextBlock Grid.Row="2" Margin="24,20"
                               Text="{loc:T Dashboard.Loading}"
                               Style="{StaticResource SecondaryTextStyle}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
