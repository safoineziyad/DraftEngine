<UserControl x:Class="DraftEngine.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="SuccessLightBrush" Color="#F0FDF4" />

        <!-- Status badge: neutral by default, accent for Generated, green for Exported. -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGenerated}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentLightBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExported}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SuccessLightBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Contract row: full-width quiet button with subtle hover. -->
        <Style x:Key="ContractRowStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource PanelBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Your agreements and drafting activity at a glance."
                               Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="New Contract"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding NewContractCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        MinWidth="140" />
            </Grid>

            <!-- Stats cards -->
            <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,20">
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Contracts created" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding ContractCount}"
                                   FontSize="28" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="20" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Estimated time saved" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock FontSize="28" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,6,0,0">
                            <Run Text="{Binding HoursSavedEstimate, Mode=OneWay}" />
                            <Run Text="h" FontSize="16" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Recent contracts -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="24,20,24,12">
                        <TextBlock Text="Recent contracts" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Run Text="{Binding ContractCount, Mode=OneWay}" />
                            <Run Text="total" />
                        </TextBlock>
                    </Grid>

                    <Border Grid.Row="1" Height="1" Background="{StaticResource BorderSubtleBrush}"
                            Margin="24,0" />

                    <!-- Contract rows -->
                    <ItemsControl Grid.Row="2" Margin="16,8,16,16"
                                  ItemsSource="{Binding RecentContracts}"
                                  Visibility="{Binding HasContracts, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ContractRowStyle}"
                                        Command="{Binding DataContext.OpenContractCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ContractType}"
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource StatusBadgeStyle}"
                                                Margin="16,0">
                                            <TextBlock Text="{Binding StatusText}" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                        <Setter Property="FontWeight" Value="Medium" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGenerated}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsExported}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding UpdatedAtText}"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="3" Text="&#x203A;"
                                                   FontSize="16"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <StackPanel Grid.Row="2" Margin="24,24,24,28"
                                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="No contracts yet."
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Create your first agreement with the New Contract button above — it only takes a few minutes."
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,4,0,14" TextWrapping="Wrap" />
                        <Button Content="New Contract"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding NewContractCommand}"
                                HorizontalAlignment="Left"
                                MinWidth="140" />
                    </StackPanel>

                    <!-- Loading -->
                    <TextBlock Grid.Row="2" Margin="24,20"
                               Text="Loading contracts…"
                               Style="{StaticResource SecondaryTextStyle}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
