<Window x:Class="DraftEngine.App.Views.LicenseActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DraftEngine.App.Services.Localization"
        Title="{loc:T License.WindowTitle}"
        Style="{StaticResource LocalizedWindowStyle}"
        Width="560" Height="320"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="13">
    <Border Padding="28">
        <StackPanel>
            <TextBlock Text="{loc:T License.Heading}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{loc:T License.Description}"
                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,16" />

            <TextBlock Text="{loc:T License.KeyLabel}" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBox x:Name="LicenseKeyBox"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                     VerticalContentAlignment="Top" Padding="8"
                     AutomationProperties.Name="{loc:T License.KeyAutomation}" />

            <TextBlock x:Name="StatusText" Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="{loc:T License.Quit}" Padding="16,4" MinWidth="90"
                        AutomationProperties.Name="{loc:T License.QuitAutomation}"
                        Click="OnQuitClick" />
                <Button Content="{loc:T License.Activate}" Padding="16,4" MinWidth="110" Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        AutomationProperties.Name="{loc:T License.ActivateAutomation}"
                        Click="OnActivateClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
