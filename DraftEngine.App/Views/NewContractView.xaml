<UserControl x:Class="DraftEngine.App.Views.NewContractView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Match the TextBox sizing of the theme. -->
        <Style TargetType="DatePicker">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,0" />
        </Style>

        <!-- Step indicator dot. -->
        <Style x:Key="StepDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource BorderSubtleBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource AccentLightBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Step indicator label. -->
        <Style x:Key="StepLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="7,0,22,0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Quiet "Preview" toggle used on clause rows. -->
        <Style x:Key="GhostToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Content" Value="Preview &#x25BE;" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleRoot" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleRoot" Property="Background" Value="{StaticResource PanelBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleRoot" Property="Background" Value="{StaticResource AccentLightBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="Hide preview" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Contract type card (step 1). -->
        <Style x:Key="TypeCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardRoot" Property="Background" Value="{StaticResource PanelBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CardRoot" Property="Opacity" Value="0.55" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="CardRoot" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="CardRoot" Property="BorderThickness" Value="2" />
                                <Setter TargetName="CardRoot" Property="Padding" Value="19" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header + step indicator -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Draft a new agreement in four steps."
                           Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Steps}" Margin="0,16,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StepDotStyle}" />
                            <TextBlock Text="{Binding Label}" Style="{StaticResource StepLabelStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Wizard content -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="24">
            <Grid>

                <!-- ======================= STEP 1: contract type ======================= -->
                <StackPanel Visibility="{Binding IsStep1Visible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Choose a contract type" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Only Mutual NDA is currently available. Other contract types are shown for preview only and cannot be selected."
                               Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,8" TextWrapping="Wrap" />
                    <TextBlock Text="Select the agreement you want to draft."
                               Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,16" />
                    <ItemsControl ItemsSource="{Binding ContractTypes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TypeCardButtonStyle}"
                                        Margin="0,0,12,12"
                                        IsEnabled="{Binding IsAvailable}"
                                        AutomationProperties.Name="{Binding Name, StringFormat=Select contract type {0}}"
                                        Command="{Binding DataContext.SelectContractTypeCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" CornerRadius="6" Padding="8,3"
                                                    Background="{StaticResource PanelBrush}"
                                                    Margin="8,0,0,0" VerticalAlignment="Top"
                                                    Visibility="{Binding IsComingSoon, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Coming soon" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding Description}"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ======================= STEP 2: intake form ======================= -->
                <ScrollViewer Visibility="{Binding IsStep2Visible, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Contract details" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Answer the questions below. These values fill the clauses and the final document."
                                   Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,16"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding IntakeFields}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="16"
                                            Background="{StaticResource PanelBrush}"
                                            Margin="0,0,12,12" VerticalAlignment="Top">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}" FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="*" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource DangerBrush}"
                                                           Visibility="{Binding IsRequired, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <TextBox Margin="0,8,0,0"
                                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="{Binding Label}"
                                                     Visibility="{Binding IsTextInput, Converter={StaticResource BoolToVis}}" />
                                            <DatePicker Margin="0,8,0,0"
                                                        SelectedDate="{Binding DateValue}"
                                                        AutomationProperties.Name="{Binding Label}"
                                                        Visibility="{Binding IsDateInput, Converter={StaticResource BoolToVis}}" />
                                            <ComboBox Margin="0,8,0,0"
                                                      ItemsSource="{Binding Choices}"
                                                      SelectedItem="{Binding SelectedChoice}"
                                                      AutomationProperties.Name="{Binding Label}"
                                                      Visibility="{Binding IsChoiceInput, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================= STEP 3: clause selection ======================= -->
                <ScrollViewer Visibility="{Binding IsStep3Visible, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <StackPanel Margin="0,0,8,0">
                        <Grid>
                            <TextBlock Text="Select clauses" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Style="{StaticResource SecondaryTextStyle}">
                                <Run Text="{Binding SelectedClauseCount, Mode=OneWay}" />
                                <Run Text="of" />
                                <Run Text="{Binding TotalClauseCount, Mode=OneWay}" />
                                <Run Text="selected" />
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="Standard clauses are pre-selected. Expand any clause to preview its text with your answers."
                                   Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,4"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Loading clauses…" Margin="0,8,0,0"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Visibility="{Binding IsLoadingClauses, Converter={StaticResource BoolToVis}}" />

                        <ItemsControl ItemsSource="{Binding ClauseGroups}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,20">
                                        <Grid Margin="4,0,4,8">
                                            <TextBlock Text="{Binding Category}" FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock HorizontalAlignment="Right" FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="{Binding Clauses.Count, Mode=OneWay}" />
                                                <Run Text="clauses" />
                                            </TextBlock>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Clauses}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Card}" Padding="16"
                                                            Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid Grid.Row="0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox Grid.Column="0"
                                                                          IsChecked="{Binding IsSelected}"
                                                                          AutomationProperties.Name="{Binding Title, StringFormat=Include {0} in the contract}"
                                                                          VerticalAlignment="Center" />
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                            Margin="10,0,0,0"
                                                                            VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}" FontSize="14"
                                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                                    <Border CornerRadius="6" Padding="8,2"
                                                                            Background="{StaticResource PanelBrush}"
                                                                            Margin="8,0,0,0"
                                                                            Visibility="{Binding IsOptional, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="Optional" FontSize="11"
                                                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <ToggleButton Grid.Column="2"
                                                                              Style="{StaticResource GhostToggleStyle}"
                                                                              AutomationProperties.Name="{Binding Title, StringFormat=Show or hide the preview of {0}}"
                                                                              IsChecked="{Binding IsExpanded}" />
                                                            </Grid>
                                                            <Border Grid.Row="1" Margin="0,12,0,0"
                                                                    Background="{StaticResource PanelBrush}"
                                                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                                                    BorderThickness="1" CornerRadius="6" Padding="14"
                                                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding PreviewText}"
                                                                           FontFamily="{StaticResource DocumentFontFamily}"
                                                                           FontSize="12.5" LineHeight="20"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           TextWrapping="Wrap" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================= STEP 4: review & generate ======================= -->
                <ScrollViewer Visibility="{Binding IsStep4Visible, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Review your contract" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Confirm the details below, then generate the document."
                                   Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,16" />
                        <Border Style="{StaticResource Card}" Padding="0">
                            <ItemsControl ItemsSource="{Binding SummaryItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="24,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <TextBlock Text="Clauses selected:" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding SelectedClauseCount}" FontSize="13"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Border>

        <!-- Footer: Back / Next / Generate -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ProgressBar Grid.Row="0" Height="3" BorderThickness="0"
                         Foreground="{StaticResource AccentBrush}"
                         Background="{StaticResource BorderSubtleBrush}"
                         IsIndeterminate="True" Margin="0,0,0,12"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <Grid Grid.Row="1">
                <Button Content="&#x2190; Back" MinWidth="100"
                        AutomationProperties.Name="Go back to the previous step"
                        Command="{Binding BackCommand}"
                        Visibility="{Binding IsBackVisible, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Left" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Next" MinWidth="120"
                            Style="{StaticResource PrimaryButtonStyle}"
                            AutomationProperties.Name="Continue to the next step"
                            Command="{Binding NextCommand}"
                            Visibility="{Binding IsNextVisible, Converter={StaticResource BoolToVis}}" />
                    <Button MinWidth="170" Margin="12,0,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding GenerateCommand}"
                            Content="{Binding GenerateButtonText}"
                            AutomationProperties.Name="{Binding GenerateButtonText}"
                            Visibility="{Binding IsGenerateVisible, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
