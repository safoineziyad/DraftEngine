<Window x:Class="DraftEngine.App.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Welcome to DraftEngine"
        Width="720" Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border Padding="36">
        <DockPanel LastChildFill="True">
            <!-- Progress -->
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{Binding StepLabel}"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,0,0,8" />
                <ProgressBar Height="4"
                             Minimum="0"
                             Maximum="{Binding StepCount}"
                             Value="{Binding StepIndex, Mode=OneWay}"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource PanelBrush}"
                             BorderThickness="0" />
            </StackPanel>

            <!-- Body -->
            <StackPanel Margin="0,32,0,0" VerticalAlignment="Top">
                <TextBlock Text="{Binding StepTitle}"
                           Style="{StaticResource PageTitleStyle}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding StepDescription}"
                           Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap"
                           FontSize="14"
                           Margin="0,12,0,22" />

                <ItemsControl ItemsSource="{Binding StepBullets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="8" Height="8" CornerRadius="4"
                                        Background="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Top"
                                        Margin="0,6,0,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Footer -->
            <Grid DockPanel.Dock="Bottom" Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Skip"
                        Style="{StaticResource QuietButtonStyle}"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Skip onboarding"
                        Command="{Binding SkipCommand}" />

                <Button Grid.Column="1"
                        Content="Back"
                        Style="{StaticResource QuietButtonStyle}"
                        Margin="0,0,10,0"
                        AutomationProperties.Name="Go back"
                        Visibility="{Binding IsNotFirst, Converter={StaticResource BoolToVis}}"
                        Command="{Binding BackCommand}" />

                <Button Grid.Column="2"
                        Content="{Binding PrimaryButtonText}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="120"
                        AutomationProperties.Name="Continue onboarding"
                        Command="{Binding NextCommand}" />
            </Grid>
        </DockPanel>
    </Border>
</Window>
