<UserControl x:Class="DraftEngine.App.Views.ProfileSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DraftEngine.App.Services.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="220" d:DesignWidth="640">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
            <TextBlock Text="{loc:T Settings.Profile.Title}" FontWeight="SemiBold" FontSize="15"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{loc:T Settings.Profile.Description}"
                       Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,10" />
            <ListBox ItemsSource="{Binding ProfileOptions}"
                     SelectedValuePath="Profile"
                     SelectedValue="{Binding SelectedProfile, Mode=TwoWay}"
                     AutomationProperties.Name="{loc:T Settings.Profile.Title}"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalAlignment="Left"
                     MinWidth="360">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" Padding="4" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="10,8" Margin="0,10,0,0"
                    Visibility="{Binding HasProfileConfirmation, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ProfileConfirmation}" TextWrapping="Wrap"
                           Style="{StaticResource SecondaryTextStyle}" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
