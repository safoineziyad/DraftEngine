<UserControl x:Class="DraftEngine.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:settings="clr-namespace:DraftEngine.App.Services.Settings"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <!-- Header -->
            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Connect DraftEngine to OpenAI and choose the defaults used for new contracts."
                       Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,20" />

            <!-- OpenAI section -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="OpenAI" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Contract data is encrypted with your Windows user profile. Do not reset your Windows password or copy the database to another Windows account — the data will be unreadable. If you plan to change Windows users, export all contracts to DOCX/PDF first."
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBlock Text="How your data is handled: when you use AI features (chat edits and AI polish), the contract text, "
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,0" />
                    <TextBlock Text="your instructions and the intake answers are transmitted to OpenAI for processing. Contract content and "
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,0" />
                    <TextBlock Text="chat history are stored encrypted on this computer. Do not use AI features for privileged or confidential "
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,0" />
                    <TextBlock Text="client material you are not permitted to share with a third-party service."
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <!-- API key -->
                    <TextBlock Text="API key" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding ApiKeyStatusText}" Margin="0,0,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasApiKey}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Masked entry (hidden while the key is shown) -->
                        <PasswordBox Grid.Column="0"
                                     settings:PasswordBoxHelper.BoundPassword="{Binding OpenAiApiKey, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="OpenAI API key"
                                     ToolTip="OpenAI API key">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>
                        <!-- Plain-text entry (Show mode) -->
                        <TextBox Grid.Column="0"
                                 Text="{Binding OpenAiApiKey, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="OpenAI API key"
                                 Visibility="{Binding IsKeyVisible, Converter={StaticResource BoolToVis}}"
                                 ToolTip="OpenAI API key" />

                        <Button Grid.Column="1" Content="{Binding ShowHideKeyText}" Margin="8,0"
                                AutomationProperties.Name="Show or hide the API key"
                                Command="{Binding ToggleKeyVisibilityCommand}" />
                        <Button Grid.Column="2" Content="Test Connection"
                                AutomationProperties.Name="Test the OpenAI connection"
                                Command="{Binding TestConnectionCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTestingConnection}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Test status -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="{Binding HasTestStatus, Converter={StaticResource BoolToVis}}">
                        <ProgressBar IsIndeterminate="True" Width="60" Height="4" VerticalAlignment="Center"
                                     Visibility="{Binding IsTestingConnection, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding TestStatusMessage}" TextWrapping="Wrap" Margin="8,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTestSuccessful}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Separator Margin="0,20,0,16" Background="{StaticResource BorderSubtleBrush}"
                               BorderBrush="{StaticResource BorderSubtleBrush}" />

                    <!-- Model selection -->
                    <TextBlock Text="Model" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding ModelOptions}"
                              SelectedItem="{Binding SelectedModel}"
                              AutomationProperties.Name="OpenAI model"
                              HorizontalAlignment="Left" Width="240" />
                    <TextBlock Text="gpt-4o-mini is faster and cheaper; gpt-4o is more capable."
                               Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Privacy section -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Privacy and AI endpoint" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Stays on this computer: contracts, intake answers, clause selections, chat history, settings and the API key (all encrypted with your Windows user profile). Sent to the AI provider only when you use an AI feature: the current contract text, your instruction, and the model name. No telemetry is collected."
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,12" />

                    <CheckBox Content="Hide party names and addresses from AI"
                              IsChecked="{Binding HidePartyNamesFromAi}"
                              AutomationProperties.Name="Hide party names and addresses from AI"
                              Margin="0,0,0,4" />
                    <TextBlock Text="When on, real party names, addresses and e-mail addresses are replaced with tokens before every AI request and restored in the reply."
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />

                    <CheckBox Content="Use a custom OpenAI-compatible endpoint"
                              IsChecked="{Binding UseCustomOpenAiEndpoint}"
                              AutomationProperties.Name="Use a custom AI endpoint"
                              Margin="0,0,0,4" />
                    <TextBlock Text="Base URL, e.g. https://your-resource.openai.azure.com/openai/deployments/… , a gateway, or http://localhost:11434/v1/ for Ollama or LM Studio."
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBox Text="{Binding OpenAiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding UseCustomOpenAiEndpoint}"
                             AutomationProperties.Name="Custom AI base URL"
                             ToolTip="Custom OpenAI-compatible base URL" />

                    <Separator Margin="0,16,0,12" Background="{StaticResource BorderSubtleBrush}"
                               BorderBrush="{StaticResource BorderSubtleBrush}" />

                    <TextBlock Text="{Binding AiConsentGranted, StringFormat=AI data-sharing consent: {0}}"
                               Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,6" />
                    <Button Content="Revoke AI consent" Padding="12,0" Height="30"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Revoke AI data-sharing consent"
                            Command="{Binding RevokeAiConsentCommand}"
                            IsEnabled="{Binding AiConsentGranted}" />
                </StackPanel>
            </Border>

            <!-- Contract defaults section -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Contract defaults" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="These values pre-fill the new contract form. You can still change them per contract."
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Governing law -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Default governing law" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding GoverningLawOptions}"
                                      SelectedItem="{Binding SelectedGoverningLaw}"
                                      AutomationProperties.Name="Default governing law" />
                        </StackPanel>

                        <!-- Term months -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Default term (months)" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding DefaultTermMonths, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                     AutomationProperties.Name="Default contract term in months"
                                     ToolTip="Contract term in months (1–120)" />
                            <TextBlock Text="{Binding TermMonthsError}" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasTermMonthsError, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="Whole number of months, between 1 and 120."
                                       Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Data safety: portable backup/restore and plain export -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Backup and data export" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="A portable backup contains contracts, intake answers, clauses, versions, chat history and non-secret settings in one password-encrypted file (AES-256-GCM). It can be restored on another Windows PC. The password is never stored; if you lose it the backup cannot be opened. The OpenAI API key is not included."
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,12" />

                    <TextBlock Text="Backup password (at least 8 characters)" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6" />
                    <PasswordBox settings:PasswordBoxHelper.BoundPassword="{Binding BackupPassword, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Backup password"
                                 ToolTip="Used only for this export or restore" />

                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Export encrypted backup" Padding="12,0" Height="30"
                                AutomationProperties.Name="Export encrypted backup"
                                Command="{Binding ExportBackupCommand}"
                                IsEnabled="{Binding CanUseBackup}" />
                        <Button Content="Restore backup..." Padding="12,0" Height="30" Margin="8,0,0,0"
                                Style="{StaticResource QuietButtonStyle}"
                                AutomationProperties.Name="Restore encrypted backup"
                                Command="{Binding RestoreBackupCommand}"
                                IsEnabled="{Binding CanUseBackup}" />
                    </WrapPanel>

                    <Separator Margin="0,16,0,12" Background="{StaticResource BorderSubtleBrush}"
                               BorderBrush="{StaticResource BorderSubtleBrush}" />
                    <TextBlock Text="Export my data" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6" />
                    <TextBlock Text="A readable, UNENCRYPTED copy for your own records or another tool. It includes contract text and intake answers; store it somewhere protected. The API key is never included."
                               Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <WrapPanel>
                        <Button Content="Export JSON..." Padding="12,0" Height="30"
                                Style="{StaticResource QuietButtonStyle}"
                                AutomationProperties.Name="Export data as JSON"
                                Command="{Binding ExportDataCommand}" CommandParameter="json"
                                IsEnabled="{Binding CanUseBackup}" />
                        <Button Content="Export CSV..." Padding="12,0" Height="30" Margin="8,0,0,0"
                                Style="{StaticResource QuietButtonStyle}"
                                AutomationProperties.Name="Export data as CSV"
                                Command="{Binding ExportDataCommand}" CommandParameter="csv"
                                IsEnabled="{Binding CanUseBackup}" />
                    </WrapPanel>

                    <TextBlock Text="{Binding BackupStatusMessage}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Style="{StaticResource SecondaryTextStyle}"
                               Visibility="{Binding HasBackupStatus, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- Save bar -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Unsaved changes indicator -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource AccentBrush}" />
                        <TextBlock Text="Unsaved changes" Style="{StaticResource SecondaryTextStyle}" Margin="8,0,0,0" />
                    </StackPanel>

                    <!-- Save status -->
                    <TextBlock Grid.Column="1" Text="{Binding SaveStatusMessage}"
                               VerticalAlignment="Center" Margin="0,0,16,0"
                               Style="{StaticResource SecondaryTextStyle}" />

                    <Button Grid.Column="2" Content="Save settings"
                            Style="{StaticResource PrimaryButtonStyle}"
                            AutomationProperties.Name="Save settings"
                            Command="{Binding SaveCommand}" VerticalAlignment="Center"
                            IsEnabled="{Binding CanSave}" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
