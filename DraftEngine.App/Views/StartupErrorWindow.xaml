<Window x:Class="DraftEngine.App.Views.StartupErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource LocalizedWindowStyle}"
        Width="620" Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        FontSize="13">
    <Border Padding="24">
        <StackPanel>
            <TextBlock x:Name="HeaderText" Style="{StaticResource PageTitleStyle}" TextWrapping="Wrap" />
            <TextBlock x:Name="BodyText" Style="{StaticResource SecondaryTextStyle}"
                       TextWrapping="Wrap" Margin="0,10,0,14" />
            <TextBlock x:Name="DiagnosticsLabel" FontWeight="SemiBold" Margin="0,0,0,6" TextWrapping="Wrap" />
            <TextBox x:Name="DiagnosticsBox" IsReadOnly="True" TextWrapping="Wrap" Height="104"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="8"
                     FontFamily="Consolas" />
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource SuccessForegroundBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CopyButton" Padding="16,4" MinWidth="150" Click="OnCopyDiagnosticsClick" />
                <Button x:Name="CloseButton" Padding="16,4" MinWidth="90" Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}" Click="OnCloseClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
