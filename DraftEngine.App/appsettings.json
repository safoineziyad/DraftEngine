{
  // Display name used for the main window title and message boxes.
  "App": {
    "DisplayName": "DraftEngine"
  },

  // OpenAI credentials. NEVER commit a real key: leave ApiKey empty here and set the
  // OPENAI_API_KEY environment variable instead — the environment variable wins over
  // this file at startup (see App.xaml.cs / AppOptions).
  "OpenAI": {
    "ApiKey": "",
    "Model": "gpt-4o-mini"
  },

  // SQLite database. Environment variables (e.g. %APPDATA%) are expanded at startup;
  // the directory is created automatically on first run.
  "Data": {
    "ConnectionString": "Data Source=%APPDATA%\\DraftEngine\\draftengine.db"
  },

  // Rolling file log. Environment variables are expanded at startup.
  "Serilog": {
    "FilePath": "%APPDATA%\\DraftEngine\\logs\\app-.log"
  },

  // The GitHub auto-update check is enabled by default and can be disabled. Other optional
  // commercial-readiness features remain disabled unless explicitly enabled.
  "Features": {
    // Offline signed license check + "license required" activation screen.
    "LicensingEnabled": false,
    // Days the app keeps working after a license expires while offline.
    "LicenseGracePeriodDays": 14,
    // Checks GitHub Releases and displays an update banner; set false to disable.
    "AutoUpdateEnabled": true,
    // Legacy optional About-page static manifest check (disabled by default).
    "UpdateCheckEnabled": false,
    // Optional static manifest URL used only by the legacy About-page check.
    "UpdateManifestUrl": "",
    // First-run onboarding dialog (three screens max).
    "OnboardingEnabled": false,
    // About/Help page in the navigation sidebar.
    "AboutEnabled": false
  }
}
